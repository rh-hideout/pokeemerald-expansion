SaffronCity_Frlg_MapScripts::
        map_script MAP_SCRIPT_ON_LOAD, SaffronCity_Frlg_SetMemoryTwinGraphics
        map_script MAP_SCRIPT_ON_TRANSITION, SaffronCity_Frlg_OnTransition
        .byte 0


@ =============================================================================
@ DYNAMIC SOL / XIE
@
@ Dad-raised path -> Xie
@ Mom-raised path -> Sol
@ =============================================================================

SaffronCity_Frlg_SetMemoryTwinGraphics:
        goto_if_set FLAG_HIDE_HOME_MOM, SaffronCity_Frlg_SetXieGraphics

        setvar VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_SOL
        return

SaffronCity_Frlg_SetXieGraphics:
        setvar VAR_OBJ_GFX_ID_1, OBJ_EVENT_GFX_XIE
        return


@ =============================================================================
@ VISIBILITY
@ =============================================================================

SaffronCity_Frlg_OnTransition:
        @ Once the first outside scene has happened,
        @ neither visitor should respawn on later Saffron loads.
        goto_if_unset FLAG_SAFFRON_TWIN_SCENE_DONE, SaffronCity_Frlg_OnTransitionDone

        setflag FLAG_HIDE_SAFFRON_MEMORY_TWIN
        setflag FLAG_HIDE_SAFFRON_PRESENT_SABRINA

        hideobjectat LOCALID_SAFFRON_MEMORY_TWIN, MAP_SAFFRON_CITY
        hideobjectat LOCALID_SAFFRON_PRESENT_SABRINA, MAP_SAFFRON_CITY

SaffronCity_Frlg_OnTransitionDone:
        end


@ =============================================================================
@ OUTSIDE-GYM SCENE
@ =============================================================================

SaffronCity_Frlg_EventScript_TwinSabrinaScene::
        @ TEMP DIAGNOSTIC
        goto_if_unset FLAG_SAFFRON_HISTORICAL_SABRINA_MET, SaffronCity_Frlg_EventScript_DebugHistoricalMissing
        goto_if_set FLAG_SAFFRON_TWIN_SCENE_DONE, SaffronCity_Frlg_EventScript_DebugSceneDone

        lockall

        @ Buffer correct mystery-person name.
        goto_if_set FLAG_HIDE_HOME_MOM, SaffronCity_Frlg_EventScript_BufferXieName

        bufferstring STR_VAR_1, SaffronCity_Frlg_Text_NameSol
        goto SaffronCity_Frlg_EventScript_TwinSabrinaContinue

SaffronCity_Frlg_EventScript_BufferXieName:
        bufferstring STR_VAR_1, SaffronCity_Frlg_Text_NameXie


SaffronCity_Frlg_EventScript_TwinSabrinaContinue:
        @ PLAYER notices the familiar stranger.
        applymovement LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft
        applymovement LOCALID_SAFFRON_MEMORY_TWIN, Common_Movement_WalkInPlaceFasterRight
        waitmovement 0

        msgbox SaffronCity_Frlg_Text_TwinYouAgain, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_PlayerSameQuestion, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_TwinSentHere, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_PlayerMineToo, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_TwinKey, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_PlayerKeyToWhat, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_TwinHopedYouKnew, MSGBOX_DEFAULT
        closemessage

        @ PLAYER explains what the Dojo memory showed.
        msgbox SaffronCity_Frlg_Text_PlayerExplainsMonths, MSGBOX_DEFAULT
        closemessage

        delay 10

        msgbox SaffronCity_Frlg_Text_TwinSixDays, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_PlayerYeah, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_TwinAreTheyDumb, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_PlayerThatsWhatISaid, MSGBOX_DEFAULT
        closemessage

        @ ====================================================
        @ PRESENT SABRINA CRASHES THE MEMORY
        @ ====================================================

        clearflag FLAG_HIDE_SAFFRON_PRESENT_SABRINA

        setobjectxyperm LOCALID_SAFFRON_PRESENT_SABRINA, 50, 18
        setobjectmovementtype LOCALID_SAFFRON_PRESENT_SABRINA, MOVEMENT_TYPE_FACE_UP
        showobjectat LOCALID_SAFFRON_PRESENT_SABRINA, MAP_SAFFRON_CITY

        applymovement LOCALID_SAFFRON_PRESENT_SABRINA, SaffronCity_Frlg_Movement_SabrinaFloatIn
        waitmovement 0

        msgbox SaffronCity_Frlg_Text_PresentSabrinaAware, MSGBOX_DEFAULT
        closemessage

        @ Both turn toward Sabrina.
        applymovement LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterDown
        applymovement LOCALID_SAFFRON_MEMORY_TWIN, Common_Movement_WalkInPlaceFasterDown
        waitmovement 0

        msgbox SaffronCity_Frlg_Text_PlayerSabrina, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_PlayerJustTalked, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_PresentSabrinaNotYet, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_TwinWhySix, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_PresentSabrinaSeventh, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_PlayerWholeDay, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_PresentSabrinaRest, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_TwinDefinitelyDumb, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_PresentSabrinaPerhaps, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_TwinRemovedSunday, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_PresentSabrinaObserved, MSGBOX_DEFAULT
        closemessage

        @ Sabrina lets one detail slip.
        msgbox SaffronCity_Frlg_Text_PresentSabrinaNeitherStay, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_PlayerNeither, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_TwinWhatMean, MSGBOX_DEFAULT
        closemessage

        delay 15

        msgbox SaffronCity_Frlg_Text_PresentSabrinaEnjoy, MSGBOX_DEFAULT
        closemessage

        @ Sabrina floats away rather than explaining herself,
        @ because of course she does.
        applymovement LOCALID_SAFFRON_PRESENT_SABRINA, SaffronCity_Frlg_Movement_SabrinaFloatOut
        waitmovement 0

        @ Sabrina remains loaded nearby but disappears from the memory.
        hideobjectat LOCALID_SAFFRON_PRESENT_SABRINA, MAP_SAFFRON_CITY

        @ PLAYER and mystery person turn back toward one another.
        applymovement LOCALID_PLAYER, Common_Movement_WalkInPlaceFasterLeft
        applymovement LOCALID_SAFFRON_MEMORY_TWIN, Common_Movement_WalkInPlaceFasterRight
        waitmovement 0

        msgbox SaffronCity_Frlg_Text_TwinDontLikeHer, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_PlayerMetToday, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_TwinAnd, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_PlayerNeitherDoI, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_TwinStickAround, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_PlayerJustNoticed, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_TwinInvestigate, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_TwinMaybeTellYou, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_PlayerMaybe, MSGBOX_DEFAULT
        closemessage

        msgbox SaffronCity_Frlg_Text_TwinMaybe, MSGBOX_DEFAULT
        closemessage

        @ First Saffron encounter is complete.
        @ Sol/Xie may remain visible for this current visit,
        @ but both visitors stay gone after Saffron reloads.
        setflag FLAG_SAFFRON_TWIN_SCENE_DONE
        setflag FLAG_HIDE_SAFFRON_MEMORY_TWIN
        setflag FLAG_HIDE_SAFFRON_PRESENT_SABRINA

        releaseall
        end


SaffronCity_Frlg_EventScript_TwinSabrinaDone:
        end


SaffronCity_Frlg_EventScript_DebugHistoricalMissing:
        msgbox SaffronCity_Frlg_Text_DebugHistoricalMissing, MSGBOX_DEFAULT
        end

SaffronCity_Frlg_EventScript_DebugSceneDone:
        msgbox SaffronCity_Frlg_Text_DebugSceneDone, MSGBOX_DEFAULT
        end


SaffronCity_Frlg_Text_DebugHistoricalMissing:
        .string "DEBUG: Historical Sabrina flag is NOT set.$"

SaffronCity_Frlg_Text_DebugSceneDone:
        .string "DEBUG: Outside scene is already marked DONE.$"




